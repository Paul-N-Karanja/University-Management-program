<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--        views and actions for only viewing students  -->
        <record id="university_view_students_action" model="ir.actions.act_window">
            <field name="name">View Students</field>
            <field name="res_model">student.record</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    View enrolled student
                </p>
            </field>
        </record>
        <record id="university_view_students_tree_view" model="ir.ui.view">
            <field name="name">university.view.Student.tree</field>
            <field name="model">student.record</field>
            <field name="arch" type="xml">
                <tree string="View Students" create="0">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="admission_number"/>
                    <field name="admission_date" optional="show"/>
                    <field name="email" optional="show"/>
                    <field name="faculty" optional="show"/>
                    <field name="course" optional="show"/>
                    <field name="currently_enrolled" optional="show"/>
                    <field name="enrollment_date" optional="show"/>
                    <field name="semester" optional="show"/>
                </tree>
            </field>
        </record>
        <record id="university_view_students_form_view" model="ir.ui.view">
            <field name="name">university.view.Student.form</field>
            <field name="model">student.record</field>
            <field name="arch" type="xml">
                <form string="View Students">
                    <sheet>
                        <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="admission_number"/>
                            <field name="admission_date"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="faculty"/>
                            <field name="course"/>
                            <field name="currently_enrolled"/>
                            <field name="enrollment_date"/>
                            <field name="semester"/>
                        </group>
                    </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
    </data>
</odoo>